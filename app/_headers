/*
  Cache-Control: no-cache, must-revalidate

/
  ! Cache-Control
  Cache-Control: no-store

/index.html
  ! Cache-Control
  Cache-Control: no-store

/web-version.json
  ! Cache-Control
  Cache-Control: no-store

/updates/*
  Access-Control-Allow-Origin: *

/updates/version.json
  ! Cache-Control
  Cache-Control: no-store
